#
# Jolla Tablet: every time the Bluetooth adapter appears (boot, or Bluetooth
# switched off and on), start the service that makes a first pairing possible.
ACTION=="add", SUBSYSTEM=="bluetooth", KERNEL=="hci0", TAG+="systemd", ENV{SYSTEMD_WANTS}+="tablet-bt-first-pairing.service"
