"""Jolla Tablet backlight remap helper.

The i915 driver in the tablet's 3.10 kernel maps the raw backlight value
0..255 onto a fixed band of the Bay Trail LPSS PWM duty cycle, about 20 % to
64 % (on-time divisor 0xcd..0x5d). Even the lowest setting is far too bright
for a dark room or a car at night. The panel itself follows the PWM all the
way down (verified by eye, 2026-10-03).

This helper takes the driver's mapping out of the path. At boot, before mce
starts, tablet-backlight-mount bind-mounts a plain file over the backlight's
"brightness" attribute, so mce writes its value there. This helper watches
that file and writes the PWM control register itself, through the pwm-byt
driver's debug attribute "test_write", with its own curve.

The driver still writes its own level, its minimum of 20 % duty, when the
panel is switched on and again when it is switched off. Against a dark setting
that shows as a flash, about 30 ms on wake and 75 ms on blank (measured
2026-10-14). So the register is watched every millisecond for a short window
at both moments, and corrected. The wake window opens on the kernel's DRM
"change" uevent, which comes about 450 ms before the driver turns the PWM on.
The blank window opens when mce writes 0; in it the backlight is switched
off at once rather than held at the floor while the panel shuts down.
Outside those windows the register is compared twice a second while the
display is on.

DPST has to be off. Intel's Android-side daemon "coreu" runs DPST, the
content-adaptive backlight: on every change of the picture it makes the driver
re-set the backlight in a burst of ten steps, 50 ms apart. With the remap in
place that shows as the brightness bumping up ten times whenever the screen is
used. The helper stops coreu through Android's init when it finds it running.

Config: /etc/tablet-backlight.conf, key=value. Reload with SIGHUP.
  floor    on-time divisor at the lowest setting (0xff = darkest)
  ceiling  on-time divisor at the highest setting (0x5d = the driver's own
           maximum; do not go lower than that without thinking about heat)
  gamma    curve between them; 1.0 is linear in duty, 2.2 feels even to the eye
  stop_dpst  1 (default) stops the coreu daemon, 0 leaves it alone
"""
import ctypes
import ctypes.util
import os
import select
import signal
import socket
import subprocess
import sys
import time

WATCH = sys.argv[1] if len(sys.argv) > 1 else "/run/tablet-backlight/brightness"
CONF = "/etc/tablet-backlight.conf"
PWM = "/sys/bus/platform/devices/80860F09:00"
RAW_MAX = 255
IN_MODIFY, IN_CLOSE_WRITE = 0x2, 0x8
NETLINK_KOBJECT_UEVENT = 15
WAKE_WINDOW = 1.5     # s of 1 ms watching after a DRM uevent
BLANK_WINDOW = 1.0    # s of 1 ms watching after mce wrote 0, or until the PWM is off

cfg = {}
reload_wanted = False


def log(msg):
    sys.stderr.write("tablet-backlight: %s\n" % msg)
    sys.stderr.flush()


def load_conf():
    cfg.update(floor=0xff, ceiling=0x5d, gamma=2.2, stop_dpst=1)
    try:
        for line in open(CONF):
            line = line.split("#")[0].strip()
            if "=" not in line:
                continue
            key, val = (s.strip() for s in line.split("=", 1))
            if key in ("floor", "ceiling"):
                cfg[key] = max(0, min(255, int(val, 0)))
            elif key == "gamma":
                cfg[key] = max(0.2, min(5.0, float(val)))
            elif key == "stop_dpst":
                cfg[key] = int(val, 0)
    except OSError:
        pass
    if cfg["ceiling"] > cfg["floor"]:
        cfg["ceiling"], cfg["floor"] = cfg["floor"], cfg["ceiling"]
    log("floor=0x%02x ceiling=0x%02x gamma=%.2f" % (cfg["floor"], cfg["ceiling"], cfg["gamma"]))


def divisor_for(raw):
    """mce's raw value (0..255) -> PWM on-time divisor (255 = darkest)."""
    if raw <= 1:
        return cfg["floor"]
    x = min(1.0, (raw - 1) / (RAW_MAX - 1))
    return int(round(cfg["floor"] - (cfg["floor"] - cfg["ceiling"]) * x ** cfg["gamma"]))


def read_raw():
    """Last number in the watched file. mce may truncate or append; both work."""
    try:
        words = open(WATCH).read().split()
        return int(words[-1]) if words else None
    except (OSError, ValueError):
        return None


def read_reg():
    try:
        return int(open(PWM + "/ctl_reg").read().strip(), 16)
    except (OSError, ValueError):
        return None


last_dpst_check = 0.0


def stop_dpst():
    """Stop coreu if Android's init says it is running. At most every 5 s."""
    global last_dpst_check
    if not cfg["stop_dpst"] or time.monotonic() - last_dpst_check < 5:
        return
    last_dpst_check = time.monotonic()
    try:
        state = subprocess.run(["/usr/bin/getprop", "init.svc.coreu"], stdout=subprocess.PIPE,
                               timeout=5).stdout.decode().strip()
        if state == "running":
            subprocess.run(["/usr/bin/setprop", "ctl.stop", "coreu"], timeout=5)
            log("coreu was running, stopped it (DPST off)")
    except (OSError, subprocess.SubprocessError) as e:
        log("could not check coreu: %s" % e)


def apply(divisor, expected=False, off=False):
    """Returns False when the PWM is disabled. off: switch it off now."""
    reg = read_reg()
    if reg is None or not reg & 0x80000000:
        return False    # PWM disabled: the panel is off, leave it to the driver
    if off:
        # Screen going off and mce at 0: the backlight goes dark now instead of
        # staying at the floor for the ~100 ms the panel takes to shut down,
        # during which it shows a few frames of half-faded content.
        try:
            with open(PWM + "/test_write", "w") as f:
                f.write("0x%x\n" % ((reg & 0x3fffffff) | 0x40000000))
        except OSError as e:
            log("write failed: %s" % e)
        return False
    if reg & 0xff == divisor:
        return True
    # Somebody else changed the register. Inside a wake or blank window that is
    # the driver; otherwise the usual somebody is DPST. stop_dpst() blocks for
    # milliseconds, so it stays out of the windows.
    if not expected:
        stop_dpst()
    # keep the frequency bits, set the new on-time, set bit 30 so it latches
    val = (reg & 0x3fffff00) | 0x80000000 | 0x40000000 | divisor
    try:
        with open(PWM + "/test_write", "w") as f:
            f.write("0x%x\n" % val)
    except OSError as e:
        log("write failed: %s" % e)
    return True


def open_uevents():
    """Kernel uevents; None if the socket cannot be had (then no wake window)."""
    try:
        s = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, NETLINK_KOBJECT_UEVENT)
        s.bind((0, 1))
        s.setblocking(False)
        return s
    except OSError as e:
        log("no uevent socket, wake flash stays: %s" % e)
        return None


def drm_change(sock):
    """Drain the socket; True if one of the events was a DRM change."""
    hit = False
    while True:
        try:
            msg = sock.recv(8192)
        except (BlockingIOError, InterruptedError):
            return hit
        except OSError:
            return hit
        if msg.startswith(b"change@") and b"SUBSYSTEM=drm" in msg:
            hit = True


def on_hup(signum, frame):
    global reload_wanted
    reload_wanted = True


def main():
    global reload_wanted
    load_conf()
    signal.signal(signal.SIGHUP, on_hup)
    libc = ctypes.CDLL(ctypes.util.find_library("c") or "libc.so.6", use_errno=True)
    fd = libc.inotify_init()
    if fd < 0 or libc.inotify_add_watch(fd, WATCH.encode(), IN_MODIFY | IN_CLOSE_WRITE) < 0:
        log("inotify on %s failed, errno %d" % (WATCH, ctypes.get_errno()))
        return 1
    log("watching %s" % WATCH)
    uev = open_uevents()
    fds = [fd] + ([uev] if uev else [])
    started = time.monotonic()
    raw = read_raw()
    window_until = window_start = 0.0
    blanking = False
    while True:
        now = time.monotonic()
        in_window = now < window_until
        # coreu starts later in the boot than this helper. Look for it actively
        # for the first three minutes; after that a register mismatch triggers it.
        if now - started < 180 and not in_window:
            stop_dpst()
        if reload_wanted:
            reload_wanted = False
            load_conf()
        if raw is not None:
            pwm_on = apply(divisor_for(raw), expected=in_window,
                           off=in_window and blanking and raw == 0)
            # blank window: the driver turns the PWM on twice more, up to
            # ~130 ms after mce's 0, before it turns it off for good
            if in_window and blanking and not pwm_on and now - window_start > 0.4:
                window_until = 0.0
                in_window = False
        # window: every millisecond. Display on: twice a second, the driver
        # rewrites the register now and then. Display off (raw 0): just wait.
        timeout = 0.001 if in_window else (0.5 if raw else 5.0)
        try:
            ready, _, _ = select.select(fds, [], [], timeout)
        except InterruptedError:
            continue
        if uev in ready and drm_change(uev) and not raw:
            window_start, window_until = time.monotonic(), time.monotonic() + WAKE_WINDOW
            blanking = False
        if fd in ready:
            os.read(fd, 4096)
        old, raw = raw, read_raw()
        if old and raw == 0:
            window_start, window_until = time.monotonic(), time.monotonic() + BLANK_WINDOW
            blanking = True


if __name__ == "__main__":
    sys.exit(main())
